<?xml version="1.0" encoding="utf-8"?>
<!-- The meter answers plain HTTP on the PC's home-network IPv4 address, which no domain rule can list;
     Pairing.parse accepts only private addresses, and the app's only other traffic, the update check, uses HTTPS URLs. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
