<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="RootWindow"
        Title="Codex 사용량 미터기"
        Width="1280" Height="820"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="False" Background="#151515"
        Foreground="#F4F4F5" FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        SnapsToDevicePixels="True" Topmost="False">
  <Window.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#1B1B1B"/><Setter Property="BorderBrush" Value="#343434"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="14"/>
    </Style>
    <Style x:Key="SubCard" TargetType="Border">
      <Setter Property="Background" Value="#232323"/><Setter Property="BorderBrush" Value="#3A3A3A"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="10"/>
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#A1A1AA"/><Setter Property="FontSize" Value="11"/></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#292929"/><Setter Property="Foreground" Value="#F4F4F5"/>
      <Setter Property="BorderBrush" Value="#454545"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,6"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#353535"/><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#5A5A5A"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.38"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#1F6F5C"/><Setter Property="BorderBrush" Value="#2F9E7E"/><Setter Property="Foreground" Value="#F0FDF9"/>
    </Style>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="34"/><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="#232323"/><Setter Property="BorderBrush" Value="#424242"/><Setter Property="FontSize" Value="15"/>
    </Style>
    <Style x:Key="QuotaBar" TargetType="ProgressBar">
      <Setter Property="Height" Value="7"/><Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="100"/>
      <Setter Property="Background" Value="#383838"/><Setter Property="Foreground" Value="#72D4B5"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid><Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4"/>
              <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="4"/></Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
      <Setter Property="Width" Value="40"/><Setter Property="Height" Value="22"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Width="40" Height="22"><Border x:Name="Track" Background="#303030" BorderBrush="#4A4A4A" BorderThickness="1" CornerRadius="11"/>
              <Ellipse x:Name="Thumb" Width="16" Height="16" Margin="3" HorizontalAlignment="Left" Fill="#B4B4B8"/></Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#1F6F5C"/><Setter TargetName="Track" Property="BorderBrush" Value="#2F9E7E"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Thumb" Property="Fill" Value="#F4F4F5"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.82"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
  <Grid x:Name="ExpandedLayout">
    <Border x:Name="ExpandedShell" Margin="0" Background="#151515" BorderThickness="0"
            CornerRadius="0" ClipToBounds="False">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
        <Border x:Name="TitleBar" Grid.Row="0" Background="#1A1A1A" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="16,0">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal"><Border Width="9" Height="9" CornerRadius="5" Background="#2F9E7E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="CODEX METER" FontWeight="Bold" FontSize="17" Foreground="#F8FAFC"/>
                <Border Background="#203B33" CornerRadius="8" Margin="9,0,0,0" Padding="7,2"><TextBlock x:Name="AccountCountBadgeText" Text="2 ACC" FontSize="9" FontWeight="Bold" Foreground="#8DE0C4"/></Border>
              </StackPanel>
              <TextBlock x:Name="AccountSummaryText" Text="계정 2개 한도 · 사용 기록 · 시스템 텔레메트리" Style="{StaticResource Muted}" Margin="17,2,0,0"/>
            </StackPanel>
            <Button x:Name="CompactModeButton" Grid.Column="1" Content="위젯" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <Button x:Name="RefreshButton" Grid.Column="2" Content="↻  갱신" Style="{StaticResource AccentButton}" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <Button x:Name="TopmostButton" Grid.Column="3" Content="TOP" ToolTip="항상 위 켜기" Style="{StaticResource IconButton}" FontSize="8" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <Button x:Name="SettingsButton" Grid.Column="4" Content="⚙" ToolTip="설정" Style="{StaticResource IconButton}" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <Button x:Name="HideButton" Grid.Column="5" Content="▁" Style="{StaticResource IconButton}" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <Button x:Name="MaximizeButton" Grid.Column="6" Content="□" ToolTip="최대화" Style="{StaticResource IconButton}" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <Button x:Name="CloseButton" Grid.Column="7" Content="×" Style="{StaticResource IconButton}" VerticalAlignment="Center"/>
          </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>

          <Border x:Name="Account1Card" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid Grid.Row="0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><StackPanel Orientation="Horizontal"><TextBlock x:Name="Account1TitleText" Text="계정 1" FontSize="16" FontWeight="Bold"/>
                  <Border Background="#203B33" CornerRadius="7" Margin="7,1,0,0" Padding="6,1"><TextBlock x:Name="Account1BadgeText" Text="1" Foreground="#8DE0C4" FontSize="9" FontWeight="Bold"/></Border></StackPanel>
                  <TextBlock x:Name="Account1Identity" Text="연결 확인 중…" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="Account1LoginButton" Content="연결" Style="{StaticResource AccentButton}" Margin="0,0,5,0"/><Button x:Name="Account1CodexLoginButton" Content="Codex로 전환" Style="{StaticResource AccentButton}" Margin="0,0,5,0" Visibility="Collapsed"/><Button x:Name="Account1LogoutButton" Content="해제"/></StackPanel>
              </Grid>
              <Border Grid.Row="1" Style="{StaticResource SubCard}" Margin="0,10,0,0"><StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Account1PrimaryName" Text="단기 한도" FontWeight="SemiBold" FontSize="12"/><TextBlock x:Name="Account1PrimaryValue" Grid.Column="1" Text="--" FontWeight="Bold" FontSize="13" Foreground="#5EEAD4"/></Grid>
                <ProgressBar x:Name="Account1PrimaryBar" Style="{StaticResource QuotaBar}" Margin="0,6,0,0"/><Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Account1PrimaryReset" Text="초기화 --" Foreground="#D4D4D8" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="Account1PrimaryRemaining" Grid.Column="1" Text="--" Foreground="#F4F4F5" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid><ProgressBar x:Name="Account1PrimaryTimeBar" Style="{StaticResource QuotaBar}" Height="4" Foreground="#38BDF8" Margin="0,5,0,0"/></StackPanel></Border>
              <Border Grid.Row="2" Style="{StaticResource SubCard}" Margin="0,7,0,0"><StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Account1SecondaryName" Text="장기 한도" FontWeight="SemiBold" FontSize="12"/><TextBlock x:Name="Account1SecondaryValue" Grid.Column="1" Text="--" FontWeight="Bold" FontSize="13" Foreground="#5EEAD4"/></Grid>
                <ProgressBar x:Name="Account1SecondaryBar" Style="{StaticResource QuotaBar}" Margin="0,6,0,0"/><Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Account1SecondaryReset" Text="초기화 --" Foreground="#D4D4D8" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="Account1SecondaryRemaining" Grid.Column="1" Text="--" Foreground="#F4F4F5" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid><ProgressBar x:Name="Account1SecondaryTimeBar" Style="{StaticResource QuotaBar}" Height="4" Foreground="#38BDF8" Margin="0,5,0,0"/></StackPanel></Border>
              <Border Grid.Row="3" Style="{StaticResource SubCard}" Margin="0,7,0,0" Padding="9,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="9" Background="#203B33" VerticalAlignment="Center"><TextBlock Text="R" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8DE0C4" FontWeight="Bold"/></Border>
                <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="Account1ResetCreditsValue" Text="초기화권 확인 중" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="Account1ResetCreditsDetail" Text="보유 여부와 만료일" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></Border>
              <UniformGrid Grid.Row="4" Columns="3" Margin="0,7,0,0">
                <Border Style="{StaticResource SubCard}" Padding="7" Margin="0,0,5,0"><StackPanel><TextBlock Text="누적 토큰" Style="{StaticResource Muted}"/><TextBlock x:Name="Account1LifetimeValue" Text="--" FontWeight="Bold" FontSize="13" Margin="0,3,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource SubCard}" Padding="7" Margin="0,0,5,0"><StackPanel><TextBlock Text="최고 일간" Style="{StaticResource Muted}"/><TextBlock x:Name="Account1PeakValue" Text="--" FontWeight="Bold" FontSize="13" Margin="0,3,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource SubCard}" Padding="7"><StackPanel><TextBlock Text="연속 사용" Style="{StaticResource Muted}"/><TextBlock x:Name="Account1StreakValue" Text="--" FontWeight="Bold" FontSize="13" Margin="0,3,0,0"/></StackPanel></Border>
              </UniformGrid>
              <Grid Grid.Row="5" Margin="0,9,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="42"/><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Account1CalendarTitle" Text="이번 달 사용량" FontWeight="SemiBold" FontSize="12"/><Button x:Name="Account1CalendarPreviousButton" Grid.Column="1" Content="‹" Width="24" Height="22" Padding="0" Margin="4,0,3,0"/><Button x:Name="Account1CalendarNextButton" Grid.Column="2" Content="›" Width="24" Height="22" Padding="0" Margin="0,0,6,0"/><TextBlock x:Name="Account1LongestTurnValue" Grid.Column="3" Text="최장 작업 --" FontSize="9" Foreground="#A1A1AA" VerticalAlignment="Center"/></Grid>
                <Grid Grid.Row="1" Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="Account1WeeklyUsageValue" Text="최근 7일 --" FontSize="8" Foreground="#8DE0C4" VerticalAlignment="Center" Margin="0,0,7,0"/><UniformGrid x:Name="Account1WeeklyUsageGrid" Grid.Column="1" Columns="7"/></Grid>
                <UniformGrid x:Name="Account1WeekdayHeader" Grid.Row="2" Columns="7" Margin="1,3,1,0"><TextBlock Text="일" FontSize="8" Foreground="#D69A9A" HorizontalAlignment="Center"/><TextBlock Text="월" FontSize="8" Foreground="#A1A1AA" HorizontalAlignment="Center"/><TextBlock Text="화" FontSize="8" Foreground="#A1A1AA" HorizontalAlignment="Center"/><TextBlock Text="수" FontSize="8" Foreground="#A1A1AA" HorizontalAlignment="Center"/><TextBlock Text="목" FontSize="8" Foreground="#A1A1AA" HorizontalAlignment="Center"/><TextBlock Text="금" FontSize="8" Foreground="#A1A1AA" HorizontalAlignment="Center"/><TextBlock Text="토" FontSize="8" Foreground="#8CB4D8" HorizontalAlignment="Center"/></UniformGrid>
                <Grid Grid.Row="3" Margin="0,3,0,0"><UniformGrid x:Name="Account1UsageGrid" Rows="6" Columns="7"/><TextBlock x:Name="Account1UsageEmpty" Text="계정 연결 후 이번 달 사용량이 표시됩니다." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
              </Grid>
              <TextBlock x:Name="Account1Status" Grid.Row="6" Text="" Style="{StaticResource Muted}" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
            </Grid>
          </Border>

          <Border x:Name="Account2Card" Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,10,0">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid Grid.Row="0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><StackPanel Orientation="Horizontal"><TextBlock x:Name="Account2TitleText" Text="계정 2" FontSize="16" FontWeight="Bold"/>
                  <Border Background="#342B18" CornerRadius="7" Margin="7,1,0,0" Padding="6,1"><TextBlock x:Name="Account2BadgeText" Text="2" Foreground="#FCD34D" FontSize="9" FontWeight="Bold"/></Border></StackPanel>
                  <TextBlock x:Name="Account2Identity" Text="연결 확인 중…" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="Account2LoginButton" Content="연결" Style="{StaticResource AccentButton}" Margin="0,0,5,0"/><Button x:Name="Account2CodexLoginButton" Content="Codex로 전환" Style="{StaticResource AccentButton}" Margin="0,0,5,0" Visibility="Collapsed"/><Button x:Name="Account2LogoutButton" Content="해제"/></StackPanel>
              </Grid>
              <Border Grid.Row="1" Style="{StaticResource SubCard}" Margin="0,10,0,0"><StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Account2PrimaryName" Text="단기 한도" FontWeight="SemiBold" FontSize="12"/><TextBlock x:Name="Account2PrimaryValue" Grid.Column="1" Text="--" FontWeight="Bold" FontSize="13" Foreground="#5EEAD4"/></Grid>
                <ProgressBar x:Name="Account2PrimaryBar" Style="{StaticResource QuotaBar}" Margin="0,6,0,0"/><Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Account2PrimaryReset" Text="초기화 --" Foreground="#D4D4D8" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="Account2PrimaryRemaining" Grid.Column="1" Text="--" Foreground="#F4F4F5" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid><ProgressBar x:Name="Account2PrimaryTimeBar" Style="{StaticResource QuotaBar}" Height="4" Foreground="#38BDF8" Margin="0,5,0,0"/></StackPanel></Border>
              <Border Grid.Row="2" Style="{StaticResource SubCard}" Margin="0,7,0,0"><StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Account2SecondaryName" Text="장기 한도" FontWeight="SemiBold" FontSize="12"/><TextBlock x:Name="Account2SecondaryValue" Grid.Column="1" Text="--" FontWeight="Bold" FontSize="13" Foreground="#5EEAD4"/></Grid>
                <ProgressBar x:Name="Account2SecondaryBar" Style="{StaticResource QuotaBar}" Margin="0,6,0,0"/><Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Account2SecondaryReset" Text="초기화 --" Foreground="#D4D4D8" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="Account2SecondaryRemaining" Grid.Column="1" Text="--" Foreground="#F4F4F5" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid><ProgressBar x:Name="Account2SecondaryTimeBar" Style="{StaticResource QuotaBar}" Height="4" Foreground="#38BDF8" Margin="0,5,0,0"/></StackPanel></Border>
              <Border Grid.Row="3" Style="{StaticResource SubCard}" Margin="0,7,0,0" Padding="9,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="9" Background="#203B33" VerticalAlignment="Center"><TextBlock Text="R" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8DE0C4" FontWeight="Bold"/></Border>
                <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="Account2ResetCreditsValue" Text="초기화권 확인 중" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="Account2ResetCreditsDetail" Text="보유 여부와 만료일" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></Border>
              <UniformGrid Grid.Row="4" Columns="3" Margin="0,7,0,0">
                <Border Style="{StaticResource SubCard}" Padding="7" Margin="0,0,5,0"><StackPanel><TextBlock Text="누적 토큰" Style="{StaticResource Muted}"/><TextBlock x:Name="Account2LifetimeValue" Text="--" FontWeight="Bold" FontSize="13" Margin="0,3,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource SubCard}" Padding="7" Margin="0,0,5,0"><StackPanel><TextBlock Text="최고 일간" Style="{StaticResource Muted}"/><TextBlock x:Name="Account2PeakValue" Text="--" FontWeight="Bold" FontSize="13" Margin="0,3,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource SubCard}" Padding="7"><StackPanel><TextBlock Text="연속 사용" Style="{StaticResource Muted}"/><TextBlock x:Name="Account2StreakValue" Text="--" FontWeight="Bold" FontSize="13" Margin="0,3,0,0"/></StackPanel></Border>
              </UniformGrid>
              <Grid Grid.Row="5" Margin="0,9,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="42"/><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Account2CalendarTitle" Text="이번 달 사용량" FontWeight="SemiBold" FontSize="12"/><Button x:Name="Account2CalendarPreviousButton" Grid.Column="1" Content="‹" Width="24" Height="22" Padding="0" Margin="4,0,3,0"/><Button x:Name="Account2CalendarNextButton" Grid.Column="2" Content="›" Width="24" Height="22" Padding="0" Margin="0,0,6,0"/><TextBlock x:Name="Account2LongestTurnValue" Grid.Column="3" Text="최장 작업 --" FontSize="9" Foreground="#A1A1AA" VerticalAlignment="Center"/></Grid>
                <Grid Grid.Row="1" Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="Account2WeeklyUsageValue" Text="최근 7일 --" FontSize="8" Foreground="#8DE0C4" VerticalAlignment="Center" Margin="0,0,7,0"/><UniformGrid x:Name="Account2WeeklyUsageGrid" Grid.Column="1" Columns="7"/></Grid>
                <UniformGrid x:Name="Account2WeekdayHeader" Grid.Row="2" Columns="7" Margin="1,3,1,0"><TextBlock Text="일" FontSize="8" Foreground="#D69A9A" HorizontalAlignment="Center"/><TextBlock Text="월" FontSize="8" Foreground="#A1A1AA" HorizontalAlignment="Center"/><TextBlock Text="화" FontSize="8" Foreground="#A1A1AA" HorizontalAlignment="Center"/><TextBlock Text="수" FontSize="8" Foreground="#A1A1AA" HorizontalAlignment="Center"/><TextBlock Text="목" FontSize="8" Foreground="#A1A1AA" HorizontalAlignment="Center"/><TextBlock Text="금" FontSize="8" Foreground="#A1A1AA" HorizontalAlignment="Center"/><TextBlock Text="토" FontSize="8" Foreground="#8CB4D8" HorizontalAlignment="Center"/></UniformGrid>
                <Grid Grid.Row="3" Margin="0,3,0,0"><UniformGrid x:Name="Account2UsageGrid" Rows="6" Columns="7"/><TextBlock x:Name="Account2UsageEmpty" Text="계정 연결 후 이번 달 사용량이 표시됩니다." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
              </Grid>
              <TextBlock x:Name="Account2Status" Grid.Row="6" Text="" Style="{StaticResource Muted}" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
            </Grid>
          </Border>

          <Border Grid.Column="2" Style="{StaticResource Card}">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="PC 성능" FontSize="16" FontWeight="Bold"/><TextBlock x:Name="PerformanceCountText" Text="장치 확인 중 · 1초 간격 측정" Style="{StaticResource Muted}"/></StackPanel>
                <Border Grid.Column="1" Background="#0C332C" BorderBrush="#176B5B" BorderThickness="1" CornerRadius="10" Padding="8,4" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#34D399" Margin="0,0,5,0"/><TextBlock Text="LIVE" Foreground="#6EE7B7" FontSize="9" FontWeight="Bold"/></StackPanel></Border>
              </Grid>
              <UniformGrid x:Name="PerformanceItemsPanel" Grid.Row="1" Columns="1" Margin="0,12,0,6"/>
              <StackPanel Grid.Row="2" VerticalAlignment="Bottom"><Border Height="1" Background="#343434"/><TextBlock x:Name="SystemStatus" Text="Windows 성능 장치 확인 중…" Style="{StaticResource Muted}" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel>
            </Grid>
          </Border>
        </Grid>

        <Border Grid.Row="2" Background="#1A1A1A" BorderBrush="#333333" BorderThickness="0,1,0,0" Padding="14,0">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
